# 管理員帳號（自訂）
ADMIN_USERNAME=admin

# 管理員密碼的 bcrypt 雜湊值。產生方式：
#   node scripts/hash-password.mjs "你想用的密碼"
# 將輸出的 hash 貼到下面。
ADMIN_PASSWORD_HASH=

# Session 簽章密鑰，任一 32+ 字元的隨機字串：
#   openssl rand -base64 32
SESSION_SECRET=

# Cloudinary 憑證（從 Cloudinary Dashboard 的 API Keys 取得）
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 給瀏覽器端 image loader 使用，與 CLOUDINARY_CLOUD_NAME 相同
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=